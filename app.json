{
  "expo": {
    "name": "Adhkar",
    "slug": "adhkar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "adhkar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dutycalc.adhkar",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dutycalc.adhkar",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A154B"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "backgroundColor": "#4A154B",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/adhan11.wav",
            "./assets/audio/adhan22.wav",
            "./assets/audio/adhan33.wav"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a1e4a11-6e0e-4af0-8cc0-cc006829ab31"
      }
    },
    "owner": "farmerintech"
  }
}
